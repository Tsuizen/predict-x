{
  "name": "predict-x",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @predict-x/web dev",
    "dev:api": "pnpm --filter @predict-x/api dev",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:api\"",
    "build": "pnpm --filter @predict-x/web build",
    "build:api": "pnpm --filter @predict-x/api build",
    "build:types": "pnpm --filter @predict-x/types build",
    "build:all": "pnpm build:types && pnpm build && pnpm build:api",
    "lint": "pnpm -r lint",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.6.3"
  }
}
